worker_processes 2;
pid /run/nginx.pid;
error_log /dev/stderr;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Increase hash bucket size for large redirect maps
    map_hash_bucket_size 256;
    map_hash_max_size 16384;

    access_log /dev/stdout;

    # Use /run for temp files (writable in Cloudron)
    client_body_temp_path /run/nginx-client-body;
    proxy_temp_path /run/nginx-proxy;
    fastcgi_temp_path /run/nginx-fastcgi;
    uwsgi_temp_path /run/nginx-uwsgi;
    scgi_temp_path /run/nginx-scgi;

    sendfile on;
    keepalive_timeout 65;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Map to get correct host without port
    map $http_x_forwarded_host $proxy_host {
        default $http_x_forwarded_host;
        ""      $host;
    }

    # ActivityPub content negotiation — detect AP clients by Accept header
    map $http_accept $is_activitypub {
        default 0;
        "~*application/activity\+json" 1;
        "~*application/ld\+json" 1;
    }

    # Markdown content negotiation — detect AI agents requesting text/markdown
    map $http_accept $wants_markdown {
        default 0;
        "~*text/markdown" 1;
    }

    # Legacy URL redirects (optional - populated via redirects.map.rmendes)
    map $uri $redirect_uri {
        default "";
        include /app/pkg/redirects.map;
    }

    # Legacy URL redirects (optional - populated via old-blog-redirects.map.rmendes)
    map $uri $old_blog_redirect {
        default "";
        include /app/pkg/old-blog-redirects.map;
    }

    # Block AI crawlers from admin paths (GPTBot, CCBot, etc.)
    # These bots follow edit/create links in static HTML and flood /posts/ and /session/
    map $http_user_agent $is_ai_crawler {
        default 0;
        "~*GPTBot"          1;
        "~*ChatGPT"         1;
        "~*CCBot"           1;
        "~*anthropic-ai"    1;
        "~*ClaudeBot"       1;
        "~*Google-Extended"  1;
        "~*Bytespider"      1;
        "~*PetalBot"        1;
        "~*Amazonbot"       1;
    }

    # ── ActivityPub federation cache ──────────────────────────────────
    # Absorbs "thundering herd" when a post goes viral and hundreds of
    # Mastodon instances simultaneously fetch actor, featured, notes.
    # Only GET/HEAD is cached; POST /inbox always reaches Node.js.
    proxy_cache_path /run/nginx-ap-cache levels=1:2 keys_zone=activitypub:10m
                     max_size=100m inactive=10m use_temp_path=off;

    # Skip cache for AP admin pages (session-dependent HTML)
    map $uri $ap_skip_cache {
        default 0;
        "~^/activitypub/admin" 1;
    }

    server {
        listen 3000;
        server_name _;

        # Use relative redirects (Cloudron handles external URL construction)
        absolute_redirect off;

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; media-src 'self' https:; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://embed.acast.com https://player.vimeo.com https://w.soundcloud.com; connect-src 'self' https: https://cdn.jsdelivr.net; base-uri 'self'; form-action 'self' https:" always;

        # Eleventy static site root
        root /app/data/site;
        index index.html;

        # Indiekit admin and API endpoints - proxy to Indiekit
        location /micropub {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /auth {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # Override CSP for auth endpoints: OAuth requires redirecting to
            # external client redirect_uris (including http://localhost for
            # CLI tools). The server-level form-action 'self' https: blocks
            # these redirects. Allow any form-action for auth routes.
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; base-uri 'self'; form-action *" always;
        }

        location /media {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            client_max_body_size 50M;
        }

        location /share {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /status {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /webmentions {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Syndication endpoint (triggers POSSE to Mastodon/Bluesky)
        location /syndicate {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Webmention sender endpoint (sends outgoing webmentions)
        location /webmention-sender {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # GitHub API endpoint (Indiekit plugin)
        location /githubapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Funkwhale API endpoint (Indiekit plugin)
        location /funkwhaleapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Last.fm API endpoint (Indiekit plugin)
        location /lastfmapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # YouTube API endpoint (Indiekit plugin)
        location /youtubeapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # RSS API endpoint (Indiekit plugin) - public page at /news/
        location /rssapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Podroll API endpoint (Indiekit plugin) - public page at /podroll/
        location /podrollapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Blogroll endpoint (Indiekit plugin) - admin UI and public API
        location /blogrollapi {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Homepage builder endpoint (admin UI + API)
        location /homepage {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Public CV page (Eleventy static)
        location = /cv/ {
            try_files /cv/index.html =404;
        }

        # CV editor endpoint (admin UI + public API)
        location /cv {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Microsub social reader endpoint
        location /microsub {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # LinkedIn OAuth endpoint (for token management)
        location /linkedin {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Conversations endpoint (threaded discussion view)
        location /conversations {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Comments endpoint (IndieAuth comment system — admin dashboard + public API)
        location /comments {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Public Read It Later page (Eleventy static)
        location = /readlater/ {
            try_files /readlater/index.html =404;
        }

        # Read It Later endpoint (admin UI + public API)
        location /readlater {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /session {
            if ($is_ai_crawler) { return 403; }
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /posts {
            if ($is_ai_crawler) { return 403; }
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit create post page
        location /create {
            if ($is_ai_crawler) { return 403; }
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location /files {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Feed files with WebSub Link header for hub discovery
        location = /feed.xml {
            add_header Link '<https://websubhub.com/hub>; rel="hub"';
            add_header Link '<https://$host/feed.xml>; rel="self"';
        }

        location = /feed.json {
            add_header Link '<https://websubhub.com/hub>; rel="hub"';
            add_header Link '<https://$host/feed.json>; rel="self"';
        }

        # Redirect /feed to /feed.xml (legacy feed URL)
        location = /feed {
            return 301 https://$host/feed.xml;
        }
        location = /feed/ {
            return 301 https://$host/feed.xml;
        }

        # Redirect /admin to Indiekit's session login with redirect to dashboard
        location = /admin {
            return 302 https://$host/session/login?redirect=/dashboard;
        }

        # Indiekit dashboard
        location = /dashboard {
            proxy_pass http://127.0.0.1:8080/;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit image resizing endpoint (thumbnails for /files and /posts)
        # IMPORTANT: Must be /image/ (with trailing slash) not /image
        # Without slash, nginx prefix-matches /images/* too, proxying static
        # files like /images/default-avatar.svg to Indiekit → auth redirect loop
        location /image/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit offline page
        location = /offline {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit plugins page (settings)
        location /plugins {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit service worker and manifest
        # Cross-origin skip is now in the SW source (@rmdes/indiekit-frontend)
        location = /serviceworker.js {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        location = /app.webmanifest {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Indiekit client ID endpoint
        location = /id {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Robots.txt from Indiekit
        location = /robots.txt {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Well-known static files (served from Eleventy site without auth)
        # Example: keybase.txt for Keybase identity verification
        # Uncomment and customize for your static .well-known files
        # location = /.well-known/keybase.txt {
        #     alias /app/data/site/.well-known/keybase.txt;
        # }

        # NodeInfo endpoint (used by Fedify for federation discovery)
        location /nodeinfo/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            add_header 'Access-Control-Allow-Origin' '*' always;

            # Cache nodeinfo (rarely changes, queried by every instance)
            proxy_cache activitypub;
            proxy_cache_valid 200 10m;
            proxy_cache_key $request_uri;
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
        }

        # Well-known endpoints (webfinger, IndieAuth, etc.) - proxy to Indiekit
        # CORS needed for browser-based AP clients querying WebFinger
        location /.well-known/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            add_header 'Access-Control-Allow-Origin' '*' always;

            # Cache webfinger and other discovery endpoints
            # $request_uri includes query string (?resource=acct:...)
            proxy_cache activitypub;
            proxy_cache_valid 200 5m;
            proxy_cache_valid 404 1m;
            proxy_cache_key $request_uri;
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
        }

        # Indiekit static assets
        location /assets {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Serve uploaded media files
        location /uploads {
            alias /app/data/uploads;
            expires 30d;
            add_header Cache-Control "public, immutable";
        }

        # Standalone interactive pages (personal content, persists across rebuilds)
        location /interactive {
            alias /app/data/interactive;
            expires 7d;
            add_header Cache-Control "public";
        }

        # =================================================================
        # LEGACY URL REDIRECTS (Examples - customize for your old domain)
        # =================================================================
        # These patterns help migrate content from old blog platforms.
        # Populate redirects.map and old-blog-redirects.map with your mappings.

        # Legacy /tag/ redirect to /categories/ (old blog platform URLs)
        rewrite "^/tag/(.+)$" "/categories/$1/" permanent;

        # Example: Rewrite old URL format to new Eleventy content paths
        # Legacy /content/ URLs — redirect to clean Indiekit URLs (reversed Feb 2026)
        # Old format: /content/TYPE/YYYY-MM-DD-slug/ → New format: /TYPE/YYYY/MM/DD/slug/
        rewrite "^/content/articles/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/articles/$1/$2/$3/$4/" permanent;
        rewrite "^/content/notes/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/notes/$1/$2/$3/$4/" permanent;
        rewrite "^/content/bookmarks/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/bookmarks/$1/$2/$3/$4/" permanent;
        rewrite "^/content/likes/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/likes/$1/$2/$3/$4/" permanent;
        rewrite "^/content/reposts/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/reposts/$1/$2/$3/$4/" permanent;
        rewrite "^/content/photos/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/photos/$1/$2/$3/$4/" permanent;
        rewrite "^/content/replies/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/replies/$1/$2/$3/$4/" permanent;
        rewrite "^/content/videos/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/videos/$1/$2/$3/$4/" permanent;
        rewrite "^/content/audio/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/audio/$1/$2/$3/$4/" permanent;
        rewrite "^/content/jams/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/jams/$1/$2/$3/$4/" permanent;
        rewrite "^/content/rsvps/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/rsvps/$1/$2/$3/$4/" permanent;
        rewrite "^/content/events/(\d{4})-(\d{2})-(\d{2})-(.+?)/?$" "/events/$1/$2/$3/$4/" permanent;

        # Example: Legacy .html URLs (e.g., from micro.blog) - redirect via map
        # Matches: /YYYY/MM/DD/slug.html
        location ~ "^/\d{4}/\d{2}/\d{2}/[^/]+\.html$" {
            if ($redirect_uri != "") {
                return 301 https://$proxy_host$redirect_uri;
            }
            return 404;
        }

        # Example: Legacy old blog URLs (e.g., from Known/WordPress) - redirect via map
        # Matches: /YYYY/slug (no month/day, no .html extension)
        location ~ "^/\d{4}/[^/]+$" {
            if ($old_blog_redirect != "") {
                return 301 https://$proxy_host$old_blog_redirect;
            }
            return 404;
        }

        # =================================================================

        # ActivityPub federation endpoint — proxy to Indiekit
        # Handles: actor, inbox, outbox, followers, following, admin UI
        # CORS headers allow browser-based AP clients (browser.pub, etc.)
        location /activitypub {
            # CORS preflight
            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' '*' always;
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Accept, Content-Type, Authorization, Signature, Digest, Date' always;
                add_header 'Access-Control-Max-Age' 86400;
                return 204;
            }

            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # Federation cache — actor profiles, featured, tags, followers
            # POST /inbox bypasses cache (only GET/HEAD cached by default)
            # Admin pages (/activitypub/admin/*) bypass via $ap_skip_cache
            proxy_cache activitypub;
            proxy_cache_valid 200 5m;
            proxy_cache_valid 404 1m;
            proxy_cache_key $request_uri;
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
            proxy_cache_background_update on;
            proxy_no_cache $ap_skip_cache;
            proxy_cache_bypass $ap_skip_cache;

            # CORS response headers
            add_header 'Access-Control-Allow-Origin' '*' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Accept, Content-Type, Authorization, Signature, Digest, Date' always;
            add_header X-Cache-Status $upstream_cache_status always;
        }

        # ── Markdown for Agents ────────────────────────────────────────
        # Serve clean Markdown for articles when requested via .md extension
        # AI agents (Claude Code, OpenCode, etc.) get raw content without HTML chrome
        location ~ "^/articles/(.+)\.md$" {
            try_files /articles/$1/index.md =404;

            # Override MIME type — nginx would default to application/octet-stream
            types { }
            default_type "text/markdown; charset=utf-8";

            # Prevent search engines from indexing the Markdown version
            add_header X-Robots-Tag "noindex" always;
            # Point to the canonical HTML version
            add_header Link '<https://$proxy_host/articles/$1/>; rel="canonical"' always;
        }

        # Markdown requests for non-article content → 406 Not Acceptable
        # Agents requesting .md for notes, bookmarks, etc. get a clear error
        location ~ "^/(?!articles/)(.+)\.md$" {
            default_type "text/plain; charset=utf-8";
            add_header Link '<https://$proxy_host/$1/>; rel="canonical"' always;
            return 406 "No Markdown version available for this content type.\nHTML version: https://$proxy_host/$1/\n";
        }

        # Default: serve Eleventy static site
        # ActivityPub clients (Mastodon, etc.) get proxied to Indiekit for
        # actor document at / and AS2 representations of individual posts
        location / {
            # Proxy headers for AP content negotiation — these are inherited
            # by the if ($is_activitypub) block below. Without them, the Host
            # header defaults to 127.0.0.1:8080 and Indiekit constructs wrong URLs.
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # Cache AP content-negotiated responses (note/article JSON-LD)
            # Only applies when proxy_pass fires (AP requests via $is_activitypub)
            # Non-AP requests go to try_files and never hit the proxy/cache
            proxy_cache activitypub;
            proxy_cache_valid 200 5m;
            proxy_cache_valid 404 1m;
            proxy_cache_key "$request_uri|ap";
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
            proxy_cache_background_update on;

            if ($is_activitypub) {
                proxy_pass http://127.0.0.1:8080;
            }
            # Markdown content negotiation for articles
            if ($wants_markdown) {
                rewrite "^(/articles/.+?)/?$" "$1.md" last;
            }
            try_files $uri $uri/ $uri.html =404;
        }

        # Error pages
        error_page 404 /404.html;
        location = /404.html {
            internal;
        }
    }
}
