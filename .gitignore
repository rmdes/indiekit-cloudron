# Dependencies
node_modules/

# Environment & secrets
.env
*.env.local
*.env.*.local
env.sh
env.sh.*

# Build artifacts (eleventy-site is a submodule)
# _site and .cache are in submodule's .gitignore

# Per-site overlays (one directory per deployment).
# Each contains config/, optional theme/, optional overrides/.
# See README "Multi-site deployment" for the convention.
#
# History — until 2026-09-10 this was a wholesale ignore EXCEPT the Plan B
# source-of-truth files (no secrets): a negation chain re-included only the
# directories needed to reach plugins.yaml and indiekit.config.js, while
# env.sh, nginx.conf and the *.map files stayed out. The per-site theme/ and
# overrides/ directories named above were dropped in the May 2026 multi-site
# refactor; per-site variance now comes from site-config at runtime.
#
# Now — the operator's own overlays live in their own repository, cloned into
# sites/. They are that operator's configuration (site identities, routes,
# secrets) and have no place in a package other people deploy.
#
# The public image still needs a generic overlay to build from. That one lives
# in examples/site-default/ (tracked), and .github/workflows/build-image.yml
# copies it into sites/default/ before running `make compose SITE=default`.
# It carries no private data — its plugins.yaml is deliberately empty so every
# plugin falls back to `default_enabled` in the registry — and it doubles as
# the reference for the shape a site config takes.
# See examples/site-default/README.md.
sites/

# The active-site marker (per machine, not committed).
.current-site

# Cache-busting build counters (per machine, auto-incremented by the Makefile).
# Not committed — they track local build state, like .current-site. Covers the
# per-site counters (.cloudron-build.<site>) AND the legacy shared fallback
# (.cloudron-build), so a fresh clone never inherits someone else's build number.
.cloudron-build*

# Legacy convention (pre-multi-site refactor) — *.<name> dot-suffixed
# overrides. Kept here so existing local checkouts don't accidentally
# commit personal data after pulling the refactored Makefile.
*.rmendes
overrides/

# Generated config (materialized at repo root by `make prepare`).
# Leading slash anchors to repo root — these patterns must NOT match
# the same filenames under sites/<name>/config/ (those are sources).
/nginx.conf
/redirects.map
/old-blog-redirects.map
/indiekit.config.js

# User content (populated at runtime)
/migrated-content/*
!/migrated-content/.gitkeep

# Legacy user-specific migration scripts (kept out of repo)
scripts/fix-post-urls.js
scripts/migrate-blog.py
scripts/migrate-content-urls.js
scripts/migrate-twitter-images.sh
scripts/node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Cloudron
*.tar.gz

# Development / testing
FRONTEND_PLAN.md
indieweb.txt
.playwright-cli/

# Local-only workspace artifacts
Daily Notes/
